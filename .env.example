# Optional. discover/inspect on api.monid.ai still need a key.
# The x402 run host 402s without one.
# MONID_API_KEY=monid_live_...

# Pay path is not the default. Refuse never needs a wallet.
# PRIVATE_KEY=

# Wash seat on the paying client (default on). Local policy always runs first.
# Listen 8788 does not sign. TWZRD_FAIL_OPEN=false only covers our 2s hang/throw.
# TWZRD_AUTO_GATE=0
# TWZRD_FAIL_OPEN=false
# TWZRD_GATE_TIMEOUT_MS=2000
# TWZRD_INTEL_BASE=https://intel.twzrd.xyz
